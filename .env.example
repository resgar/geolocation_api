# Copy this file to .env and fill in real values:
#   cp .env.example .env
#
# docker compose reads .env automatically and passes these through as real
# environment variables (see the `environment:` block in docker-compose.yml).

# Bearer token required on every API request.
# See app/controllers/concerns/api_authentication.rb
API_TOKEN=

# ipstack access key for live geolocation lookups.
# Get one free at https://ipstack.com/
# See app/services/geolocation/adapters/ipstack.rb
IPSTACK_API_KEY=
